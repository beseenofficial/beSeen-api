NODE_ENV=development
PORT=3000
DB_URI=mongodb://127.0.0.1:27017
DB_NAME=beseen
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
STELLAR_NETWORK=public
AUTH_DOMAIN=beseen.app
AUTH_CHALLENGE_TTL_SECONDS=300
REGISTRATION_TOKEN_TTL_SECONDS=600
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BROADCAST_DRAFT_TTL_SECONDS=604800
BROADCAST_CLEANUP_INTERVAL_SECONDS=300

# Docker Compose values. Keep the password URL-safe because it is embedded in DB_URI.
API_PORT=3000
MONGO_ROOT_USERNAME=beseen_root
MONGO_ROOT_PASSWORD=replace_with_a_long_random_alphanumeric_password
MONGO_REPLICA_SET_KEY=ReplaceWithLongRandomBase64ReplicaSetKey1234567890
MONGO_APP_USERNAME=beseen_app
MONGO_APP_PASSWORD=replace_with_another_long_random_alphanumeric_password
