# Allowed values: "development", "test", "production"
NODE_ENV=development

# HTTP port the server listens on.
PORT=5000

# MongoDB connection string.
DB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true

# MongoDB database name.
DB_NAME=beseen

# Stellar network to operate on.
# Allowed values: "public", "testnet"
STELLAR_NETWORK=testnet

# Soroban RPC endpoint URL.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# BeSeen Soroban contract ID (starts with C).
BESEEN_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Stellar source account public key used for RPC simulation (starts with G).
BESEEN_RPC_SOURCE_ACCOUNT=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAL7NV

# Ledger where this contract deployment was created — replace the example with the exact ledger.
BESEEN_CONTRACT_START_LEDGER=0

# How many ledgers of contract events are fetched per batch.
BESEEN_CONTRACT_EVENT_LEDGER_BATCH_SIZE=50000

# Stellar secret key of the verifier account (starts with S).
BESEEN_VERIFIER_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# Domain used for authentication and token claims.
AUTH_DOMAIN=beseen.fi

# Base URL of the Blux API.
BLUX_BASE_URL=https://api.blux.cc

# Blux application ID.
BLUX_APP_ID=replace-with-your-blux-app-id

# Blux application secret.
BLUX_APP_SECRET=replace-with-your-blux-app-secret

# Timeout for Blux verification requests in milliseconds.
BLUX_VERIFICATION_TIMEOUT_MS=5000

# Cloudflare R2 S3-compatible endpoint URL.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Cloudflare R2 access key ID.
R2_ACCESS_KEY_ID=replace-with-a-new-r2-access-key-id

# Cloudflare R2 secret access key.
R2_SECRET_ACCESS_KEY=replace-with-a-new-r2-secret-access-key

# R2 bucket used for avatar storage.
R2_BUCKET_NAME=beseen-avatars

# Public base URL that serves the R2 bucket content.
R2_PUBLIC_BASE_URL=https://images.beseen.fi

# Maximum allowed avatar upload size in bytes.
R2_MAX_AVATAR_BYTES=5242880

# Secret used to sign access tokens.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Access token lifetime in seconds.
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds.
REFRESH_TOKEN_TTL_SECONDS=2592000

# How long broadcast drafts are kept, in seconds.
BROADCAST_DRAFT_TTL_SECONDS=604800

# Interval between broadcast cleanup runs, in seconds.
BROADCAST_CLEANUP_INTERVAL_SECONDS=300

# Logging verbosity.
# Allowed values: "fatal", "error", "warn", "info", "debug", "trace", "silent"
LOG_LEVEL=info
