NODE_ENV=development
PORT=3000
DB_URI=mongodb://127.0.0.1:27017
DB_NAME=beseen
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
STELLAR_NETWORK=public
AUTH_DOMAIN=beseen.app
